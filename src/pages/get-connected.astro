---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Get Connected" description="Two easy ways to plug into ENMU Chi Alpha — Chi Alpha Night and small groups.">
  <!-- Page intro -->
  <section class="container-page py-2xl md:py-3xl text-center">
    <p class="uppercase tracking-widest text-small-lg font-medium text-clay mb-xs">Get Connected</p>
    <h1 class="font-display font-bold text-hero md:text-hero-lg mb-sm">Find Your People</h1>
    <p class="text-body md:text-h4 max-w-prose mx-auto text-charcoal/80">
      Come to Chi Alpha Night, join a small group, or both &mdash; there&rsquo;s no wrong way in.
    </p>
  </section>

  <!-- Large Group: Chi Alpha Night -->
  <section class="container-page pb-2xl md:pb-3xl grid gap-lg md:grid-cols-2 items-center">
    <div class="aspect-square rounded-brand overflow-hidden border border-clay/30 w-full max-w-sm mx-auto">
      <img
        src="/images/gallery-chi-alpha-night.png"
        alt="Chi Alpha Night photo collage — students gathered for worship and community"
        class="w-full h-full object-cover"
      />
    </div>
    <div>
      <p class="uppercase tracking-widest text-small-lg font-medium text-clay mb-xs">Large Group</p>
      <h2 class="font-display font-semibold text-h2 md:text-h2-lg mb-sm">Chi Alpha Night</h2>
      <p class="font-body font-medium text-small-lg text-clay mb-sm">
        Thursdays · 7:00 PM · Sandia Room (CUB)
      </p>
      <p class="text-body max-w-prose mb-lg">
        This is where our whole community comes together &mdash; worship, a short message, and
        real connection with people who actually want to know you. Everyone is welcome. Stick
        around after and you&rsquo;ll usually find us hanging out, laughing, and making the night
        last a little longer.
      </p>
    </div>
  </section>

  <!-- Small Group -->
  <section class="bg-sage/10 py-2xl md:py-3xl">
    <div class="container-page grid gap-lg md:grid-cols-2 items-center">
      <div class="order-2 md:order-1">
        <p class="uppercase tracking-widest text-small-lg font-medium text-clay mb-xs">Small Group</p>
        <h2 class="font-display font-semibold text-h2 md:text-h2-lg mb-sm">Small Groups</h2>
        <p class="font-body font-medium text-small-lg text-clay mb-sm">Throughout the Week</p>
        <p class="text-body max-w-prose mb-md">
          A smaller crew and living room feel where we dig into Scripture together. Real life,
          real questions, and a real community to be a part of. We think small group will become
          the highlight of your week.
        </p>
        <div class="grid gap-sm sm:grid-cols-2 mb-lg">
          <div class="bg-cream rounded-brand p-md">
            <p class="font-display font-semibold text-h4 mb-[2px]">Guys Small Group</p>
            <p class="text-small-lg text-charcoal/80">TBD</p>
          </div>
          <div class="bg-cream rounded-brand p-md">
            <p class="font-display font-semibold text-h4 mb-[2px]">Girls Small Group</p>
            <p class="text-small-lg text-charcoal/80">TBD</p>
          </div>
        </div>
      </div>
      <div class="aspect-square rounded-brand overflow-hidden border border-clay/30 order-1 md:order-2 w-full max-w-sm mx-auto">
        <img
          src="/images/gallery-small-group.png"
          alt="All About Small Group — guys small group Monday nights, girls small group Tuesday nights"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="bg-green-dark text-cream py-xl md:py-2xl">
    <div class="container-page text-center">
      <h2 class="font-display font-semibold text-h2 md:text-h2-lg mb-sm text-cream">Ready to Connect?</h2>
      <p class="text-body max-w-prose mx-auto mb-lg text-cream/90">
        Fill out our connect card and we&rsquo;ll reach out personally &mdash; no pressure, just a
        hello.
      </p>
      <a href="/contact" class="btn bg-green text-cream hover:brightness-110">Contact Us</a>
    </div>
  </section>
</Layout>
