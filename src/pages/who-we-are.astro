---
import Layout from '../layouts/Layout.astro';

const whatWereAbout = [
  {
    number: '01',
    title: 'Real Devotion',
    desc: 'Following Jesus includes more than just going to church. It’s about knowing and experiencing God personally, both through the Bible and through authentic prayer. Everything we do centers around knowing and being known by God.',
  },
  {
    number: '02',
    title: 'Real Community',
    desc: 'College wasn’t meant to be lived alone. This is why small groups and large group are essential — these are the places where real friendship is both forged and discovered through laughter, honesty, encouragement, and authenticity.',
  },
  {
    number: '03',
    title: 'Real Responsibility',
    desc: 'What God does in us, he wants to do through us. God has uniquely gifted you with the ability and the joy of making a difference, so we want to help connect you to that purpose, whether it means serving on campus or taking the gospel around the world.',
  },
];

const leaders = [
  {
    name: 'Justin Vistine',
    role: 'Campus Pastor',
    image: '/images/team-justin.jpeg',
    imagePosition: 'object-top',
  },
  {
    name: 'Jeremy Licano',
    role: 'Staff',
    image: '/images/team-jeremy.jpeg',
  },
  {
    name: 'Marissa Vistine',
    role: 'Staff',
    image: '/images/team-marissa.jpeg',
  },
];
---

<Layout title="Who We Are" description="Meet ENMU Chi Alpha — our story, what we believe, and the people leading it.">
  <!-- Intro + Our Story -->
  <section class="bg-sage/10 py-2xl md:py-3xl">
    <div class="container-page grid gap-lg md:grid-cols-2 items-center">
      <div class="aspect-[4/3] rounded-brand overflow-hidden order-2 md:order-1">
        <img
          src="/images/who-we-are.jpeg"
          alt="Chi Alpha students laughing together"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="order-1 md:order-2">
        <h1 class="font-display font-bold text-h2 md:text-h2-lg mb-sm text-clay">
          A Place Where People Can Belong Before They Believe
        </h1>
        <p class="text-body max-w-prose mb-md">
          Whether you&rsquo;re looking for friends, a place to grow spiritually, or simply people
          who will know your name, we&rsquo;d love to meet you. We want Chi Alpha to feel like a
          home away from home, where you&rsquo;ll find friends who genuinely care about you, a
          place where your questions are welcome, and a community that points you toward Jesus.
        </p>
        <div class="border-t-2 border-clay/40 pt-md">
          <h2 class="font-display font-bold text-h2 md:text-h2-lg mb-sm text-clay">Our Story</h2>
          <p class="text-body max-w-prose mb-sm">
            Our Chi Alpha ministry was planted at ENMU in 2023 by a team from New Mexico State
            University. As part of a nationwide movement reaching college campuses, we&rsquo;re
            excited to see students encounter Jesus, grow together, and make a difference on
            campus and beyond.
          </p>
          <p class="text-body max-w-prose">
            Whether you grew up in church, walked away from it, or have never been in one, you are
            welcome to come with your questions, to meet authentic people, and to figure out what
            you believe through honest conversations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What We're About -->
  <section class="py-2xl md:py-3xl">
    <div class="container-page">
      <h2 class="font-display font-semibold text-h2 md:text-h2-lg mb-lg text-center">
        What We&rsquo;re About
      </h2>
      <div class="grid gap-lg sm:grid-cols-3">
        {whatWereAbout.map((item) => (
          <div class="border-l-[3px] border-clay pl-md">
            <p class="font-display font-bold text-h2 text-clay mb-[2px]">{item.number}</p>
            <h3 class="font-display font-semibold text-h4 mb-xs">{item.title}</h3>
            <p class="text-body">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What We Believe -->
  <section class="bg-sage/10 py-xl md:py-2xl">
    <div class="container-page max-w-2xl mx-auto text-center">
      <h2 class="font-display font-semibold text-h3 md:text-h3-lg mb-sm">What We Believe</h2>
      <p class="text-body max-w-prose mx-auto mb-sm">
        We are an evangelical Christian ministry affiliated with the General Council of the
        Assemblies of God. Our teaching is rooted in the Bible and historic Christian beliefs.
      </p>
      <a
        href="https://chialpha.com/our-story/"
        target="_blank"
        rel="noopener noreferrer"
        class="font-body font-medium text-body text-green hover:text-green-dark underline underline-offset-2"
      >
        Learn more about our beliefs
      </a>
    </div>
  </section>

  <!-- Leadership -->
  <section class="container-page py-2xl md:py-3xl">
    <h2 class="font-display font-semibold text-h2 md:text-h2-lg mb-lg text-center">
      Meet the Team
    </h2>
    <div class="grid gap-md sm:grid-cols-3 max-w-3xl mx-auto">
      {leaders.map((leader) => (
        <div class="text-center">
          {leader.image ? (
            <div class="aspect-square rounded-brand overflow-hidden mb-sm">
              <img
                src={leader.image}
                alt={leader.name}
                class={`w-full h-full object-cover ${leader.imagePosition ?? ''}`}
              />
            </div>
          ) : (
            <div class="aspect-square rounded-brand bg-sage/20 flex items-center justify-center mb-sm">
              <!-- TODO: replace with a real staff photo -->
              <span class="text-charcoal/40 text-small">Photo coming soon</span>
            </div>
          )}
          <p class="font-display font-semibold text-h4">{leader.name}</p>
          <p class="font-body text-small-lg text-clay uppercase tracking-wide">{leader.role}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="bg-green-dark text-cream py-xl md:py-2xl">
    <div class="container-page text-center">
      <h2 class="font-display font-semibold text-h2 md:text-h2-lg mb-sm text-cream">Come Say Hi</h2>
      <p class="text-body max-w-prose mx-auto mb-lg text-cream/90">
        The best way to get to know us is in person &mdash; we&rsquo;d love to meet you.
      </p>
      <a
        href="/get-connected"
        class="btn bg-green text-cream hover:brightness-110"
      >
        Get Connected
      </a>
    </div>
  </section>
</Layout>
