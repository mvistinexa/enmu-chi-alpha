---
interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Who We Are', href: '/who-we-are' },
  { label: 'Get Connected', href: '/get-connected' },
  { label: 'Resources', href: '/resources' },
];
---

<header
  id="site-header"
  data-transparent={transparent ? 'true' : 'false'}
  class={
    transparent
      ? 'fixed top-0 inset-x-0 z-40 bg-transparent border-b border-transparent transition-colors duration-300'
      : 'sticky top-0 z-40 bg-cream/95 backdrop-blur border-b border-sage/30 transition-colors duration-300'
  }
>
  <div class="container-page flex items-center justify-between h-[72px]">
    <a
      href="/"
      data-header-logo
      class={`font-display font-semibold text-h4 md:text-h4-lg transition-colors duration-300 ${transparent ? 'text-cream' : 'text-green'}`}
    >
      ENMU Chi Alpha
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-lg" aria-label="Primary">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-header-link
          class={`font-body text-body transition-colors duration-300 ${transparent ? 'text-cream hover:text-cream/70' : 'text-charcoal hover:text-green'}`}
        >
          {link.label}
        </a>
      ))}
      <a href="/contact" class="btn-primary">Contact Us</a>
    </nav>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      data-header-link
      class={`md:hidden inline-flex items-center justify-center w-10 h-10 rounded-brand transition-colors duration-300 ${transparent ? 'text-cream' : 'text-charcoal'}`}
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile nav panel -->
  <nav
    id="mobile-menu"
    class="md:hidden hidden flex-col gap-sm px-sm pb-md bg-cream"
    aria-label="Primary mobile"
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="font-body text-body text-charcoal hover:text-green transition-colors py-xs"
      >
        {link.label}
      </a>
    ))}
    <a href="/get-connected" class="btn-primary w-full mt-xs">Contact Us</a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('flex');
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
  });
</script>

<script>
  const header = document.getElementById('site-header');

  if (header?.dataset.transparent === 'true') {
    const logo = header.querySelector('[data-header-logo]');
    const links = header.querySelectorAll('[data-header-link]');
    const scrollThreshold = 40;

    const updateHeader = () => {
      const scrolled = window.scrollY > scrollThreshold;

      header.classList.toggle('bg-cream/95', scrolled);
      header.classList.toggle('backdrop-blur', scrolled);
      header.classList.toggle('border-sage/30', scrolled);
      header.classList.toggle('bg-transparent', !scrolled);
      header.classList.toggle('border-transparent', !scrolled);

      logo?.classList.toggle('text-green', scrolled);
      logo?.classList.toggle('text-cream', !scrolled);

      links.forEach((link) => {
        link.classList.toggle('text-charcoal', scrolled);
        link.classList.toggle('hover:text-green', scrolled);
        link.classList.toggle('text-cream', !scrolled);
        link.classList.toggle('hover:text-cream/70', !scrolled);
      });
    };

    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });
  }
</script>
