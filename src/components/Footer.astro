---
const year = new Date().getFullYear();
---

<footer class="bg-charcoal text-cream">
  <div class="container-page py-xl grid gap-lg md:grid-cols-3">
    <div>
      <p class="font-display font-semibold text-h4 text-cream mb-xs">ENMU Chi Alpha</p>
      <p class="text-small-lg text-cream/80 max-w-prose">
        A community of ENMU students figuring out life and faith together.
        Come as you are.
      </p>
    </div>

    <div>
      <p class="font-body font-medium text-small-lg uppercase tracking-wide text-sage mb-xs">
        Find Us
      </p>
      <address class="not-italic text-small-lg text-cream/80 leading-relaxed">
        <!-- TODO: replace with real meeting location -->
        CUB Ballroom, ENMU Campus<br />
        1500 S Ave K, Portales, NM 88130
      </address>
    </div>

    <div>
      <p class="font-body font-medium text-small-lg uppercase tracking-wide text-sage mb-xs">
        Connect
      </p>
      <ul class="flex flex-col gap-xs text-small-lg text-cream/80">
        <li>
          <!-- TODO: replace with real email -->
          <a href="mailto:enmuchialpha@gmail.com" class="hover:text-white transition-colors">
            enmuchialpha@gmail.com
          </a>
        </li>
        <li>
          <!-- TODO: replace with real Instagram handle -->
          <a href="https://instagram.com" class="hover:text-white transition-colors">
            Instagram
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-cream/10">
    <div class="container-page py-sm text-small text-cream/60">
      &copy; {year} ENMU Chi Alpha. All rights reserved.
    </div>
  </div>
</footer>
